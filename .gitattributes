# Normalise line endings in the repository; Windows clones still get CRLF where Git decides so.
* text=auto

# Shell scripts must check out LF even on Windows clones: CRLF makes bash fail with an opaque
# "bad interpreter" / "\r: command not found" on the Linux CI runners that execute them.
*.sh   text eol=lf

# Binary assets — no line-ending conversion, no text diff.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
