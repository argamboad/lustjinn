# Copy to `.env.staging` (gitignored) and fill in. Used with: uv run --env-file .env.staging <command>
# Only what differs from `.env` goes here; everything else still comes from `.env`.

# Neon's DIRECT connection string (not the pooled one), in asyncpg form:
#   postgresql://… becomes postgresql+asyncpg://…, and the query string is just ?ssl=require
LUSTJINN_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
