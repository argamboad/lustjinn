# Copy this file to `.env` and fill it in. `.env` is gitignored: never commit it.
# Every variable is read by src/lustjinn/settings.py. Real environment variables win over this file.

# Postgres. This default matches docker-compose.yml (`docker compose up -d`).
LUSTJINN_DATABASE_URL=postgresql+asyncpg://lustjinn:lustjinn@localhost:5440/lustjinn

# The one user who can sign in.
LUSTJINN_USERNAME=
LUSTJINN_PASSWORD=

# Signs the bearer tokens; at least 32 characters. Changing it signs every device out.
# Generate one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
LUSTJINN_TOKEN_SECRET=

# Optional. Days a sign-in lasts (default 30).
# LUSTJINN_TOKEN_DAYS=30

# Optional. Browser origins allowed to call the API, as a JSON list (default: none).
# LUSTJINN_CORS_ORIGINS=["http://localhost:5173"]
